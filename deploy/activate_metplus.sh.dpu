#!/usr/bin/env bash
# Aktivasi MET + METplus di server DPU (user: dpu)
# Usage: source ~/apps/activate_metplus.sh

export MET_INSTALL_DIR="${MET_INSTALL_DIR:-$HOME/apps/MET}"
export METPLUS_BASE="${METPLUS_BASE:-$HOME/apps/METplus}"
export PATH="$MET_INSTALL_DIR/bin:$METPLUS_BASE/ush:$HOME/miniforge3/bin:$PATH"
export LD_LIBRARY_PATH="$MET_INSTALL_DIR/lib:${LD_LIBRARY_PATH:-}"

if [ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]; then
  # shellcheck disable=SC1091
  source "$HOME/miniforge3/etc/profile.d/conda.sh"
  conda activate metplus 2>/dev/null || true
fi

echo "MET:     $(command -v grid_stat 2>/dev/null || echo missing)"
echo "METplus: $(command -v run_metplus.py 2>/dev/null || echo missing)"
