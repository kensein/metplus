# Model Verification — webpsi (display-only)
#
# Path: /var/www/model-verification
# URL:  https://psimkg.bmkg.go.id/model-verification/
# API:  :8020   Web: :3020

SERVE_READONLY=true
STORE_BACKEND=f32
BASE_PATH=/model-verification
API_PORT=8020
FRONTEND_PORT=3020
DEFAULT_METHOD=harp
METHODS=harp,metplus

# HARP artifacts (bisa symlink ke /var/www/monas/data/artifacts)
ARTIFACTS_DIR=/var/www/model-verification/data/artifacts
HARP_STORE_DIR=/var/www/model-verification/data/artifacts

# METplus artifacts (symlink ke verifikasi-inanwp data)
METPLUS_DATA_DIR=/var/www/model-verification/data/metplus

# Opsional: key peta
# CARTO_API_KEY=
# CORS_ORIGIN=https://psimkg.bmkg.go.id

# BMKG Soft (obs) — isi di server, jangan commit secret
# BMKG_API_BASE=https://bmkgsatu.bmkg.go.id
# BMKG_USERNAME=psimkg
# BMKG_PASSWORD=
