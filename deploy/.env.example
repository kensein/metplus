# Environment production — server webpsi
# Salin ke /var/www/verifikasi-inanwp/.env
# JANGAN commit file .env ke git

# Frontend static server
PORT=3013
HOSTNAME=127.0.0.1
BASE_PATH=/verifikasi-inanwp

# Backend API (server/.env — duplikasi variabel yang relevan)
HOST=127.0.0.1
API_PORT=8013
CORS_ORIGIN=https://psimkg.bmkg.go.id
NODE_ENV=production

# Data directory — output METplus dari litbangweb (via rsync)
DATA_DIR=/var/www/verifikasi-inanwp/data
METPLUS_DATA_DIR=/var/www/verifikasi-inanwp/data/metplus

# rsync source (untuk script sync, opsional)
LITBANGWEB_HOST=litbangweb.bmkg.go.id
LITBANGWEB_USER=your_user
LITBANGWEB_SOURCE=/mnt/wdd1/www/htdocs/wrf/metplus/dashboard
