# Konfigurasi dashboard (server deploy terpisah)
# Salin ke dashboard/.env

# Sumber data output METplus dari server webpsi
# Opsi 1: HTTP/HTTPS endpoint (disarankan untuk deploy terpisah)
DATA_SOURCE_URL=https://webpsi.example.com/wrf/metplus/dashboard

# Opsi 2: Path lokal (jika di-mount via NFS/SMB)
# DATA_SOURCE_PATH=/mnt/webpsi/metplus/dashboard

# Opsi 3: Path relatif untuk development
# DATA_SOURCE_PATH=../sample_data/dashboard

# Interval refresh otomatis (detik), 0 = manual
REFRESH_INTERVAL=3600

# Domain verifikasi
DOMAIN_NAME=Indonesia
MODEL_NAME=INanWP
OBS_NAME=GSMAP NRT
